{
  "$schema": "sovereign-template-v1.json",
  "id": "AI_aggressive_expansionist",
  "name": "Aggressive Expansionist",
  "description": "Classic warmonger: conquers, subjugates, and dominates through military force and relentless expansion.",

  "identity": {
    "personality_key": "aggressive_expansionist",
    "archetype": "expansionist",
    "ethics_match": {
      "required": [],
      "preferred": ["militarist", "fanatic_militarist", "xenophobe"],
      "forbidden": ["pacifist", "fanatic_pacifist"]
    },
    "authority_match": {
      "preferred": [],
      "forbidden": []
    },
    "civic_affinity": []
  },

  "origins": {
    "default": "origin_default",
    "preferred": [
      {
        "origin": "origin_doomsday",
        "reason": "Homeworld explosion forces urgent expansion; perfectly matches aggressive early expansion",
        "economy_overrides": { "weight_factors": { "expansion": 3.0 } }
      },
      {
        "origin": "origin_clone_army",
        "reason": "Clone soldiers provide early military advantage without alloy cost for armies"
      },
      {
        "origin": "origin_hegemon",
        "reason": "Starts as federation president with 2 subjects; immediate diplomatic leverage for vassalization"
      }
    ],
    "compatible": ["origin_default", "origin_galactic_doorstep", "origin_lost_colony", "origin_fear_of_the_dark"],
    "forbidden": ["origin_tree_of_life", "origin_primal_calling"]
